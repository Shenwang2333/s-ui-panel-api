SUI_NODE_API_URL=https://your-control-plane.example.com/api/nodes/your-node/config
SUI_NODE_ID=your-node
SUI_NODE_TOKEN_FILE=/etc/sing-box/node-token
SING_BOX_BINARY=/usr/local/bin/sing-box
SING_BOX_CONFIG_GROUP=sing-box
SING_BOX_CONFIG=/etc/sing-box/config.json
SING_BOX_LEGACY_USERS_FILE=/etc/sing-box/legacy-hysteria2-users.json
HYSTERIA2_LISTEN_PORT=8443
HYSTERIA2_SERVER_NAME=your-edge-hysteria-host.example.com
HYSTERIA2_CERTIFICATE=/etc/sing-box/certs/fullchain.pem
HYSTERIA2_PRIVATE_KEY=/etc/sing-box/certs/privkey.pem
VMESS_LISTEN_PORT=10444
VMESS_PATH=/swcc
SUI_NODE_POLL_INTERVAL=10
SUI_NODE_REQUEST_TIMEOUT=15
